{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "prompts/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 4 * * *" }
  ],
  "rewrites": [
    { "source": "/api/meal/:action", "destination": "/api/meal?action=:action" },
    { "source": "/api/workout/:action", "destination": "/api/workout?action=:action" },
    { "source": "/api/food/barcode/:ean", "destination": "/api/meal?action=barcode&ean=:ean" },
    { "source": "/api/day/:action", "destination": "/api/day?action=:action" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
