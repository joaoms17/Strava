{
  "functions": {
    "api/meal.ts": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 60
    },
    "api/workout.ts": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 60
    },
    "api/day.ts": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 60
    },
    "api/cron/daily.ts": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 60
    },
    "api/cron/lembretes.ts": {
      "maxDuration": 60
    },
    "api/health/daily.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 5 * * *" },
    { "path": "/api/cron/lembretes", "schedule": "45 20 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/meal/:action", "destination": "/api/meal?action=:action" },
    { "source": "/api/workout/:action", "destination": "/api/workout?action=:action" },
    { "source": "/api/food/barcode/:ean", "destination": "/api/meal?action=barcode&ean=:ean" },
    { "source": "/api/day/:action", "destination": "/api/day?action=:action" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
