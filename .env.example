# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só no servidor (env vars do Vercel) — nunca no cliente
SUPABASE_SERVICE_ROLE_KEY=

# Cliente (o Vite só expõe ao browser variáveis VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — só usado em /api
ANTHROPIC_API_KEY=

# Integrações
HEALTH_INGEST_TOKEN=
ICS_TOKEN=

# Cron do Vercel (o Vercel envia Authorization: Bearer <CRON_SECRET>).
# Também abre o estado do deploy: /api/day/health?token=<CRON_SECRET>
CRON_SECRET=
