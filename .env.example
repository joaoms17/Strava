# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só no servidor (env vars do Vercel) — nunca no cliente
SUPABASE_SERVICE_ROLE_KEY=

# Cliente (o Vite só expõe ao browser variáveis VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA — só usado em /api. Basta uma das chaves: com GEMINI_API_KEY usa o
# Gemini (Google, plano gratuito); sem ela, o Claude (Anthropic, pago).
# AI_PROVIDER=gemini|anthropic força uma delas.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
# Opcional: outros modelos Gemini (por omissão gemini-flash-latest para as
# fotos e gemini-flash-lite-latest para o texto e de reserva)
GEMINI_MODEL_VISION=
GEMINI_MODEL_TEXT=

# Integrações
HEALTH_INGEST_TOKEN=
ICS_TOKEN=

# Cron do Vercel (o Vercel envia Authorization: Bearer <CRON_SECRET>).
# Também abre o estado do deploy: /api/day/health?token=<CRON_SECRET>
CRON_SECRET=
